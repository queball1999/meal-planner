# Go Eat — example environment file.
# Copy to .env and fill in your values. .env is gitignored.

# ── Core ──────────────────────────────────────────────────────────────────

APP_NAME=Go Eat
LISTEN_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080

# SQLite database path (file: URI or plain path).
DATABASE_URL=file:./data/goeat.db

# Required: at least 32 random characters.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-32-char-secret

# First-run setup token. Until the first account exists, the setup wizard asks
# for a token so a stranger who reaches the page first can't claim the server.
# Leave blank and a random one is printed ONCE to the server log (stderr) at
# startup - look for "Setup token: ..." in `docker compose logs goeat`.
# Anyone who can read that log before setup finishes can claim the instance.
# The token stops working as soon as setup completes. If set, it must be at
# least 24 hex characters: openssl rand -hex 16
SETUP_TOKEN=

# More than one household on this server. Off (default): everyone works in
# the one household setup created, and the household switcher and the
# create/delete household controls are hidden. On: an admin can create more
# households, and each user switches between the ones they belong to.
# Household roles (owner / editor / viewer) apply either way.
ENABLE_MULTI_TENANT=false

# ── AI provider (Phase 3) ─────────────────────────────────────────────────

# Every provider below can be filled in at once; PROVIDER picks which one is
# used. All of these are also editable from Settings → AI Provider, where the
# model dropdown can pull the live list from the provider.
# PROVIDER=openai_compatible   # anthropic | openai | google | openai_compatible

# Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5
# OPENAI_API_URL=https://api.openai.com/v1

# Google Gemini (OpenAI-compatible endpoint):
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash
# GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Any OpenAI-compatible server (Ollama, LM Studio, llama.cpp, vLLM):
# LLM_API_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=

# Sampling, shared by every provider. LLM_TOP_K is sent to OpenAI-compatible
# and Anthropic backends; LLM_MIN_P to OpenAI-compatible endpoints only.
# LLM_MAX_TOKENS=4096
# LLM_PLAN_MAX_TOKENS=16384   # per meal-plan generation call
# LLM_TEMPERATURE=1.01
# LLM_TOP_P=0.91
# LLM_TOP_K=20
# LLM_MIN_P=0.1
# LLM_PRESENCE_PENALTY=1.52

# ── Pricing (Phase 4) ─────────────────────────────────────────────────────

# PRICE_CACHE_TTL_HOURS=168
# AI_PRICE_ESTIMATE_ENABLED=true

# Kroger official API. For credential rotation, set comma-separated,
# position-aligned lists in CLIENT_ID / CLIENT_SECRET (one app per position).
# KROGER_CLIENT_ID=
# KROGER_CLIENT_SECRET=
# KROGER_LOCATION_ID=
# KROGER_MAX_RPM=60
# KROGER_DAILY_CAP=9500

# Scraper (off by default — per-store opt-in):
# SCRAPER_<STORE>_ENABLED=false
# SCRAPE_FETCH_TIMEOUT_SECONDS=15
# SCRAPE_MAX_BYTES=5242880
# SCRAPE_RATE_LIMIT_PER_MIN=10

# Headless browser for scraping (optional, §6.7/§6.8).
# Stores that block plain HTTP or render prices in JavaScript need one of these.
# Spin one up with: docker compose -f docker-compose.browserless.yml up -d
# Both can also be set from the Settings page, where changes take effect at once.
#
#   RENDER_BACKEND=auto           -> run both and pick per page (recommended)
#   RENDER_BACKEND=browserless    -> real Chrome, runs the page's JavaScript
#   RENDER_BACKEND=flaresolverr   -> solves Cloudflare-style challenges
#
# Under auto, RENDER_URL is the Browserless service and FLARESOLVERR_URL the
# other one. A bot wall goes to FlareSolverr first, a JavaScript-only page to
# Browserless first, and whichever runs first falls back to the other.
# Inside Docker use the compose service name, never localhost - localhost in
# the Go Eat container is the container itself.
# RENDER_BACKEND=auto
# RENDER_URL=http://browserless:3000
# RENDER_TOKEN=change-me
# FLARESOLVERR_URL=http://flaresolverr:8191

# ── Security (LAN defaults — all false, §9.2) ─────────────────────────────

# LOCKOUT_ENABLED=false
# RATE_LIMIT_ENABLED=false
# CAPTCHA_ENABLED=false
# BOT_PROTECTION_ENABLED=false
# REQUIRE_2FA=false

# ── Week boundaries (§5.5, §11.1) ────────────────────────────────────────

# WEEK_START_DAY=sunday
# WEEK_END_DAY=saturday

# Local hour (0-23) the Saturday night before the week starts to automatically
# generate next week's plan. -1 (default) disables auto-generation; the
# Regenerate / Plan my week button in the app always works regardless.
# AUTO_PLAN_HOUR=-1

# ── Search & barcode (Phase 5.8) ──────────────────────────────────────────

# SEARCH_PARTIAL_DEFAULT=true
# SEARCH_FUZZY_DEFAULT=true
# BARCODE_LOOKUP_ENABLED=true
# NORMALIZE_AI_ASSIST_ENABLED=false

# ── Recipe images (Phase 5.7) ─────────────────────────────────────────────

# RECIPE_IMAGE_DIR=./data/recipe-images
# RECIPE_WEB_SEARCH_ENABLED=false

# ── Item catalog images (00010_items.sql) ─────────────────────────────────

# ITEM_IMAGE_DIR=./data/item-images

# ── Home Assistant shopping-list sync (00012_ha_sync.sql) ─────────────────
# Usually set from Settings → Home Assistant instead (the token is stored
# encrypted). These .env values act as a fallback / initial seed.

# HA_BASE_URL=http://homeassistant.local:8123
# HA_TOKEN=                       # long-lived access token
# HA_TODO_ENTITY=todo.shopping_list
# HA_SYNC_INTERVAL_MINUTES=0      # 0 = background pull disabled (push on demand still works)
# HA_ITEM_FORMAT=name_qty         # name | name_qty
