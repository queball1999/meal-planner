# Go Eat — example environment file.
# Copy to .env and fill in your values. .env is gitignored.

# ── Core ──────────────────────────────────────────────────────────────────

APP_NAME=Go Eat
LISTEN_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080

# SQLite database path (file: URI or plain path).
DATABASE_URL=file:./data/goeat.db

# Required: at least 32 random characters.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-32-char-secret

# ── AI provider (Phase 3) ─────────────────────────────────────────────────

# PROVIDER=openai_compatible   # anthropic | openai | google | openai_compatible
# LLM_API_URL=http://localhost:11434/v1   # Ollama example
# LLM_MODEL=llama3.2
# LLM_API_KEY=
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.7

# Anthropic (if PROVIDER=anthropic):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Pricing (Phase 4) ─────────────────────────────────────────────────────

# PRICE_CACHE_TTL_HOURS=168
# AI_PRICE_ESTIMATE_ENABLED=true

# Kroger official API:
# KROGER_CLIENT_ID=
# KROGER_CLIENT_SECRET=
# KROGER_LOCATION_ID=

# Scraper (off by default — per-store opt-in):
# SCRAPER_<STORE>_ENABLED=false
# SCRAPE_FETCH_TIMEOUT_SECONDS=15
# SCRAPE_MAX_BYTES=5242880
# SCRAPE_RATE_LIMIT_PER_MIN=10

# FlareSolverr (optional companion, §6.8):
# FLARESOLVERR_ENABLED=false
# FLARESOLVERR_URL=http://localhost:8191/v1

# ── Security (LAN defaults — all false, §9.2) ─────────────────────────────

# LOCKOUT_ENABLED=false
# RATE_LIMIT_ENABLED=false
# CAPTCHA_ENABLED=false
# BOT_PROTECTION_ENABLED=false
# REQUIRE_2FA=false

# ── Week boundaries (§5.5, §11.1) ────────────────────────────────────────

# WEEK_START_DAY=sunday
# WEEK_END_DAY=saturday

# ── Search & barcode (Phase 5.8) ──────────────────────────────────────────

# SEARCH_PARTIAL_DEFAULT=true
# SEARCH_FUZZY_DEFAULT=true
# BARCODE_LOOKUP_ENABLED=true
# NORMALIZE_AI_ASSIST_ENABLED=false

# ── Recipe images (Phase 5.7) ─────────────────────────────────────────────

# RECIPE_IMAGE_DIR=./data/recipe-images
# RECIPE_WEB_SEARCH_ENABLED=false
