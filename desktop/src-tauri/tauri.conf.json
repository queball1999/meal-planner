{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Go Eat",
  "version": "0.1.0",
  "identifier": "com.goeat.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "go run ../cmd/build_sidecar",
    "beforeBuildCommand": "go run ../cmd/build_sidecar"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "category": "Lifestyle",
    "shortDescription": "Budget-first meal planner",
    "longDescription": "Plan a week of meals around a grocery budget, build the shopping list, and track what's in the pantry. Runs entirely on this computer.",
    "copyright": "Quynn Bell",
    "externalBin": [
      "binaries/goeat"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
